{
  "name": "zeynep-celtek-guzellik",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "node scripts/build.mjs",
    "start": "node ./node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "start:db": "node scripts/start.mjs",
    "lint": "eslint",
    "optimize:images": "node scripts/optimize-images.mjs",
    "make:favicon": "node scripts/make-favicon.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:editor": "tsx prisma/upsert-editor-content.ts",
    "db:upsert:catalog": "tsx scripts/upsert-catalog.ts",
    "db:upsert:blog": "tsx scripts/upsert-blog.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "edge >= 111",
    "not dead",
    "not op_mini all"
  ],
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@imgly/background-removal": "^1.7.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "mariadb": "^3.5.4",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "png-to-ico": "^2.1.8"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp",
    "mariadb": "$mariadb",
    "mysql2": "3.24.6",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "zod": "$zod",
    "minimatch": "11.0.4",
    "nanoid": "3.3.20"
  }
}

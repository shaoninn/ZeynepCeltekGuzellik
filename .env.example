# Zeynep Çeltek Güzellik — Environment

# Hostinger panelinde NODE_ENV mutlaka production olmalı (development yazma)
NODE_ENV="production"

# JWT_SECRET: production'da en az 32 karakter rastgele bir değer kullanın
JWT_SECRET="CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_HERE"
NEXT_PUBLIC_SITE_URL="https://zeynepceltekguzellik.local"

# --- MySQL (alanlar daha sonra doldurulacak) ---
# MYSQL_USER=""
# MYSQL_PASSWORD=""
# MYSQL_HOST=""
# MYSQL_PORT="3306"
# MYSQL_DATABASE=""
# Normal: 3. Hostinger "Maksimum İşlem" kırmızıysa: 1 + MYSQL_SERIALIZE=1
# MYSQL_POOL_SIZE="3"
# MYSQL_SERIALIZE="1"

# Seed / bootstrap (canlıda bir kez)
# ADMIN_EMAIL="admin@zeynepceltekguzellik.local"
# ADMIN_PASSWORD="GucluSifre123"
# BOOTSTRAP_SECRET="rastgele-kurulum-anahtari"
# ALLOW_PROD_SEED="true"

# --- Medya işleme ---
# REMOVE_BG_API_KEY=""          # Opsiyonel Remove.bg (yoksa tarayıcıda WASM kullanılır)
# --- Instagram canlı feed (Meta Developer) ---
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_USER_ID=""
# Mail (opsiyonel)
# RESEND_API_KEY=""
# SMTP_URL=""
# MAIL_FROM="Zeynep Çeltek Güzellik <info@zeynepceltekguzellik.local>"
# MAIL_MANUFACTURER="info@zeynepceltekguzellik.local"

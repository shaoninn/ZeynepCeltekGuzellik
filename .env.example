# Zeynep Çeltek Güzellik — Environment

# Hostinger panelinde NODE_ENV mutlaka production olmalı (development yazma)
NODE_ENV="production"

# JWT_SECRET: production'da en az 32 karakter rastgele bir değer kullanın
JWT_SECRET="CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_HERE"
NEXT_PUBLIC_SITE_URL="https://zeynepceltek.com"

# --- MySQL (alanlar daha sonra doldurulacak) ---
# MYSQL_USER=""
# MYSQL_PASSWORD=""
# MYSQL_HOST=""
# MYSQL_PORT="3306"
# MYSQL_DATABASE=""
# Normal: 3. Hostinger "Maksimum İşlem" kırmızıysa: 1 + MYSQL_SERIALIZE=1
# MYSQL_POOL_SIZE="3"
# MYSQL_SERIALIZE="1"
# MYSQL_CONNECT_TIMEOUT_MS="12000"
# MYSQL_ACQUIRE_TIMEOUT_MS="15000"
# HEALTH_TOKEN=""  # set to lock /api/health; else 12 req/min/IP

# Seed / bootstrap (canlıda bir kez)
# ADMIN_EMAIL="admin@zeynepceltekguzellik.local"
# ADMIN_PASSWORD="GucluSifre123"
# BOOTSTRAP_SECRET="rastgele-kurulum-anahtari"
# ALLOW_PROD_SEED="true"

# --- Medya işleme ---
# REMOVE_BG_API_KEY=""          # Opsiyonel Remove.bg (yoksa tarayıcıda WASM kullanılır)
# Mail (opsiyonel)
# RESEND_API_KEY=""
# SMTP_URL=""
# MAIL_FROM="Zeynep Çeltek Güzellik <info@zeynepceltekguzellik.local>"
# MAIL_MANUFACTURER="info@zeynepceltekguzellik.local"

# --- Analytics / Ads (çerez onayı olmadan yüklenmez) ---
# NEXT_PUBLIC_GA_ID="G-XXXXXXXX"
# NEXT_PUBLIC_AW_ID="AW-XXXXXXXX"
# NEXT_PUBLIC_AW_SEND_TO="AW-XXXXXXXX/XXXX"
# NEXT_PUBLIC_META_PIXEL_ID=""

# --- Cron / bakım ---
# GET /api/cron/digest — Authorization: Bearer …
# CRON_SECRET="rastgele-cron-anahtari"
# PURGE_SECRET="rastgele-purge-anahtari"  # cron yoksa digest de bunu kabul eder; debug/catalog header

# --- PayTR (güvenli kart ödemesi) ---
# Mağaza Paneli → Bilgi sayfasından alınır. Callback URL:
#   https://DOMAIN/api/payments/paytr/callback
# PAYTR_MERCHANT_ID=""
# PAYTR_MERCHANT_KEY=""
# PAYTR_MERCHANT_SALT=""
# PAYTR_TEST_MODE="1"          # canlıda 0 veya sil
# PAYTR_UI_ENABLED="1"         # veya Ayarlar → paytr_ui_enabled=1
